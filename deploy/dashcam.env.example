# Audio dashcam configuration. Copy to ~/audio-dashcam/dashcam.env and edit.
# Every value here is optional; the defaults are shown.

# How much audio to keep in memory. This is the upper bound on a single
# capture, and it dominates RAM use: seconds x 48000 x channels x 4 bytes.
#   30  ->  44 MB      120 -> 176 MB      600 -> 879 MB
RING_SECONDS=120

# Which hardware input to open (substring match on the PortAudio device name).
DEVICE_MATCH=EP-136
CHANNELS=8
SAMPLE_RATE=48000

# Which channels carry the stereo master, 1-indexed as the hardware labels
# them.
#
# The EP-136 presents 8 inputs as four stereo record pairs. Teenage Engineering
# does not document which USB pair is which, so it was measured (2026-09-08) by
# playing into mixer channel 1 and comparing levels with the fader up and down:
#
#   USB 1/2  MAIN      post-fader  -- moved 20.8 dB with the fader
#   USB 3/4  CH1 tap   pre-fader   -- did not move at all
#   USB 5/6  CH2 or AUX            -- silent in both runs, not disambiguated
#   USB 7/8  CH2 or AUX            -- silent in both runs, not disambiguated
#
# Use 1,2. A pre-fader tap ignores the mixer entirely: it records one channel
# strip at its own limiter ceiling, so faders, and anything plugged into the
# other inputs, are missing from the take.
#
# scripts/channel-probe.py re-runs that measurement if the map is ever in doubt.
SAVE_CHANNELS=1,2

# Write all CHANNELS to the take instead of just the pair above. Useful for
# stems; costs 4x the disk.
SAVE_ALL_CHANNELS=false

# Refuse to save below this much free space.
MIN_FREE_GB=1.0

# Keep at most this many takes, deleting the oldest. 0 disables pruning.
MAX_SAVES=0

# Raising this is the fix for PortAudio busy-polling a USB device; there is no
# reason to want low latency for a ring buffer.
INPUT_LATENCY_MS=100
